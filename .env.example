# ==============================================================================
# HEALTH DECK — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure for your environment.
# In development (HEALTHDECK_ENV=development), most variables have sensible fallbacks.
# In production (HEALTHDECK_ENV=production), strict validation is enforced on startup.

# --- Environment Mode ---
# Options: development | production | test
HEALTHDECK_ENV=development

# --- Public Domain & URL ---
# In development: LAN IP (e.g. http://192.168.1.50:8000) or http://localhost:8000
# In production: Mandatory HTTPS public domain (e.g. https://api.healthdeck.hospital.com)
HEALTHDECK_PUBLIC_BASE_URL=http://localhost:8000

# --- CORS Allowed Origins ---
# Comma-separated list of origins allowed to access the API with credentials.
# In development: defaults to '*' if left blank.
# In production: MANDATORY. Wildcards ('*') are strictly forbidden.
# Example: HEALTHDECK_ALLOWED_ORIGINS=https://kiosk.hospital.com,https://clinician.hospital.com
HEALTHDECK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Clinician Authentication (Phase 2) ---
# Cryptographic secret key for signing JWT tokens (HMAC-SHA256).
# In production: MUST be at least 32 characters of high-entropy random string.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
HEALTHDECK_JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
HEALTHDECK_JWT_EXPIRATION_HOURS=12

# --- Central PostgreSQL Database (Phase 3) ---
# In development: if unset, automatically falls back to local SQLite (healthdeck.db).
# In production: MANDATORY PostgreSQL connection string. SQLite fallback is forbidden.
DATABASE_URL=postgresql://healthdeck_user:healthdeck_password@localhost:5432/healthdeck_db
HEALTHDECK_DB_POOL_MIN=2
HEALTHDECK_DB_POOL_MAX=10

# --- Persistent File Storage ---
# Persistent directories for uploads and PDF reports.
# When running in containers, mount persistent volume disks to these paths.
HEALTHDECK_UPLOADS_DIR=uploads
HEALTHDECK_REPORTS_DIR=reports

# --- Rate Limiting & Abuse Prevention ---
# Thread-safe in-memory sliding-window limiter for single-instance deployments.
HEALTHDECK_RATE_LIMIT_ENABLED=true
# Optional per-endpoint limit overrides (requests per minute per IP):
# HEALTHDECK_LIMIT_LOGIN=5
# HEALTHDECK_LIMIT_CASES=10
# HEALTHDECK_LIMIT_TRIAGE_START=10
# HEALTHDECK_LIMIT_TRIAGE_STEP=30
# HEALTHDECK_LIMIT_TRIAGE_TRANSCRIBE=10
# HEALTHDECK_LIMIT_UPLOAD=10

# --- LLM Reasoning (Groq) ---
# Free key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
HEALTHDECK_LLM_PROVIDER=groq
# HEALTHDECK_GROQ_MODEL=openai/gpt-oss-120b

# --- Vision Analysis (Multimodal LLM) ---
HEALTHDECK_VISION_PROVIDER=groq
# HEALTHDECK_VISION_MODEL=qwen/qwen3.6-27b

# --- Speech to Text (Faster Whisper) ---
# Model sizes: tiny | base | small | medium | large-v3 (default: small)
HEALTHDECK_WHISPER_MODEL=small
HEALTHDECK_STT_PROVIDER=faster-whisper

# --- Grounded Medical Search (Tavily - Optional) ---
# Free API key: https://app.tavily.com
HEALTHDECK_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_key_here

# --- Red-Flag WhatsApp Alerts (Twilio - Optional) ---
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_TO=whatsapp:+10000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Initial Seed Doctor Account (Optional) ---
# Created on startup if configured and doctor does not already exist:
# HEALTHDECK_ADMIN_USERNAME=admin_doctor
# HEALTHDECK_ADMIN_EMAIL=admin.doctor@hospital.internal
# HEALTHDECK_ADMIN_PASSWORD=replace_with_secure_password
# HEALTHDECK_ADMIN_NAME=Dr. Sarah Chen, MD
# HEALTHDECK_ADMIN_LICENSE=MD-89241-CA
# HEALTHDECK_ADMIN_DEPARTMENT=Emergency / Critical Care
