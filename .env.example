# Copy this file to .env and fill in what you have. Everything except the LLM
# key is optional; missing pieces just no-op (see README).

# --- QR photo upload: SET THIS for the QR to work off-device ---
# The kiosk shows a QR that the patient scans with their PHONE. The phone is a
# different device on the network, so the URL must be this machine's LAN IP,
# not localhost. Find it with `ipconfig` (Windows) or `ipconfig getifaddr en0`
# (mac). Leave it as localhost and the QR renders but no phone can open it.
HEALTHDECK_PUBLIC_BASE_URL=http://localhost:8000

# --- LLM: required for a live demo ---
# Free Groq key, no card: https://console.groq.com/keys
GROQ_API_KEY=your_key_here
# Optional overrides:
# HEALTHDECK_LLM_PROVIDER=groq
# HEALTHDECK_GROQ_MODEL=openai/gpt-oss-120b
# HEALTHDECK_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Photo vision analysis: optional ---
# "groq" reuses GROQ_API_KEY with a multimodal model; "ollama" uses a local
# vision model (default llava); "mock" for tests. Without a working provider
# a submitted photo is stored but image_analysis stays null.
HEALTHDECK_VISION_PROVIDER=groq
# HEALTHDECK_VISION_MODEL=qwen/qwen3.6-27b   # or e.g. llava for ollama

# --- Speech input: local, free, no key ---
# faster-whisper model size: tiny | base | small | medium | large-v3.
# "small" is the default balance. The model downloads once on first use.
HEALTHDECK_WHISPER_MODEL=small
# HEALTHDECK_STT_PROVIDER=faster-whisper     # or "mock" for tests

# --- Grounded self-care advice: optional ---
# Free Tavily signup, no card: https://app.tavily.com  ->  "API Keys".
# With this set, self_care_advice for non-escalated cases is rewritten from
# search results on trusted medical domains and the sources are shown.
# Without it, the model writes self_care_advice unaided and no sources appear.
HEALTHDECK_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_key_here

# --- Red-flag WhatsApp alerts via the Twilio Sandbox: optional ---
# Free Twilio trial: https://www.twilio.com/try-twilio
# In the console: Messaging -> Try it out -> Send a WhatsApp message. That page
# shows the sandbox number and a join code like "join <two-words>".
# EACH number in TWILIO_WHATSAPP_TO must send that join code from its own
# WhatsApp to the sandbox number once, or Twilio will not deliver to it.
# Without all three of SID / TOKEN / TO, red-flag alerts are logged and skipped.
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
# Comma-separated list, one join per number:
TWILIO_WHATSAPP_TO=whatsapp:+10000000000,whatsapp:+10000000001
# Defaults to the standard Twilio sandbox number if left unset:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
